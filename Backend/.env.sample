# Application
ENVIRONMENT=development
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Public backend origin, without /api; used for avatar URLs.
PUBLIC_BACKEND_URL=http://localhost:8000
# Optional locally (defaults to Backend/uploads/avatars).
# Docker sets this inside a persistent uploads volume.
# AVATAR_STORAGE_DIR=/app/uploads/avatars

# Scheduling: explicit deployment timezone; code falls back to UTC if omitted.
DEFAULT_TIMEZONE=Asia/Karachi

# SMTP: required for contact and reminder emails. Use a Gmail app password
# when using Gmail. Leave credentials out of version control.
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USE_TLS=True
MAILER_USERNAME=
MAILER_PASSWORD=
# Empty values below fall back to MAILER_USERNAME.
MAILER_FROM=
CONTACT_EMAIL_TO=

# Database (required)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/symptom-sense

# JWT (required)
SECRET_KEY=your-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2 (optional; leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Password hashing (optional; default 12; use 10 in prod for less CPU)
BCRYPT_ROUNDS=12

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: DB pool (defaults 5 and 10; use lower on small EC2, e.g. 2 and 3)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Optional: set false to skip migrations in container
# ALEMBIC_RUN_MIGRATIONS=true
